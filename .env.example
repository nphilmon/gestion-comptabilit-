# ============================================================
#  Gestion Comptabilité — Variables d'environnement
#  Copiez ce fichier en .env et adaptez les valeurs.
#  Le fichier .env NE doit JAMAIS être commité.
# ============================================================

# --- Base de données ---
GESTION_COMPTA_DB_HOST=localhost
GESTION_COMPTA_DB_NAME=gestion_compta
GESTION_COMPTA_DB_USER=root
GESTION_COMPTA_DB_PASS=
GESTION_COMPTA_DB_CHARSET=utf8mb4

# --- URL de base de l'application ---
# Exemples :
#   Développement local WAMP/XAMPP : /gestion%20comptabilit%C3%A9/
#   Production sous-dossier         : /compta/
#   Production à la racine          : /
GESTION_COMPTA_BASE_URL=/gestion%20comptabilit%C3%A9/

# --- Module PDP / Facturation électronique (optionnel) ---
# Clé d'API de votre plateforme PDP (Portail de Dépôt Public ou équivalent).
# Laissez vide si le module PDP n'est pas activé.
GESTION_COMPTA_PDP_API_KEY=
